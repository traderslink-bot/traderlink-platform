+function rejectedWithoutChanges(f: ReturnType<typeof fixture>, action: () => void, code: SharedAlertError["code"]) {
+  const before = f.facts();
+  expect(action).toThrow(expect.objectContaining({ code }));
+  expect(f.facts()).toEqual(before);
+}
