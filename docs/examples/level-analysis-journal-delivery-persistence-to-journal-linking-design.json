      "id",
      "createdAt",
      "updatedAt",
      "workspaceId",
      "accountId",
      "userId",
      "savedTradeId",
      "symbol",
      "provider",
      "linkStatus",
      "deliveryId",
      "rawPayloadHash",
      "sourceKind",
      "symbolSummaryAsOfTimestamp",
      "matchPolicy",
      "matchResult",
      "linkedSymbolSummary",
      "limitations",
      "safetyFlags",
      "auditTrail"
    ]
  },
  "matchPolicy": {
    "policyVersion": "journal_level_analysis_trade_link_match_policy_v1",
