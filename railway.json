{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/api/platform/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 30,
    "preDeployCommand": [
      "node -e 'process.exitCode=78;eval(Buffer.from(process.env.TRADERLINK_ROOT_PREDEPLOY_GATE_B64,\"base64\").toString())'"
    ],
    "preDeployTimeoutSeconds": 120
  }
}
