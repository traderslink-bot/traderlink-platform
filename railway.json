{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.migration-maintenance"
  },
  "deploy": {
    "healthcheckPath": null,
    "healthcheckTimeout": null,
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": null,
    "overlapSeconds": 0,
    "drainingSeconds": 30,
    "startCommand": "./node_modules/.bin/tsx src/scripts/run-hosted-platform-migration-maintenance.ts"
  }
}
