{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.coaching-maintenance"
  },
  "deploy": {
    "healthcheckPath": "/api/platform/health",
    "healthcheckTimeout": 900,
    "restartPolicyType": "NEVER",
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
