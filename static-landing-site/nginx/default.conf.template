server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve Railway private-service DNS at request time so a Platform
    # container replacement does not leave this long-lived front door pinned
    # to retired A or AAAA records.
    include /etc/nginx/runtime/railway-resolver.conf;
    set $platform_upstream "${PLATFORM_UPSTREAM}";

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The marketing root is deliberately static. Future static landing pages
    # can be added here without rebuilding the private Platform application.
    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    # The static front door owns discovery for independently published landing
    # pages while the Platform sitemap continues to cover Help and Academy.
    location = /robots.txt {
        try_files /robots.txt =404;
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /landing-pages-sitemap.xml {
        try_files /landing-pages-sitemap.xml =404;
        default_type application/xml;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /trading-journal {
        try_files /trading-journal/index.html =404;
    }

    location = /trading-journal/ {
        return 301 /trading-journal;
    }

    location = /trade-analyzer {
        try_files /trade-analyzer/index.html =404;
    }

    location = /trade-analyzer/ {
        return 301 /trade-analyzer;
    }

    location = /landing-assets {
        return 301 /landing-assets/;
    }

    location ^~ /landing-assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    # Keep every existing public Platform route on Railway: Help, Academy,
    # Watchlist, News, legal pages, APIs, and the Watchlist SSE stream.
    # PLATFORM_UPSTREAM must be a Railway private-network origin with no
    # trailing slash, for example
    # http://traderlink-platform-web.railway.internal:8080.
    location / {
        proxy_pass $platform_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
